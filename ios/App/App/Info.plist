<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.kaikodo.app</string>
			</array>
		</dict>
	</array>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>NSLocationWhenInUseUsageDescription</key>
		<string>Kaikōdo no utiliza tu ubicación. Este permiso es requerido por una dependencia (OneSignal) aunque la funcionalidad no está activa en la app.</string>
	<!-- Fix: sin estas dos claves, iOS mata la app en el acto (crash duro,
	     sin excepción capturable en JS) en cuanto un <input type="file"
	     capture> intenta abrir la cámara o la librería de fotos dentro del
	     WKWebView (p. ej. al añadir un recibo en Gastos). Android no exige
	     esto antes de usarlas (pide permiso en tiempo de ejecución), por eso
	     el mismo flujo funcionaba bien ahí y no en iOS. -->
	<key>NSCameraUsageDescription</key>
		<string>Kaikōdo usa la cámara para que puedas fotografiar recibos y adjuntarlos a tus gastos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
		<string>Kaikōdo accede a tus fotos para que puedas adjuntar imágenes de recibos, documentos y fotos del viaje.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Kaikōdo guarda fotos en tu galería cuando descargas una imagen desde la app.</string>
	<key>CFBundleDisplayName</key>
        <string>Kaikōdo</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
