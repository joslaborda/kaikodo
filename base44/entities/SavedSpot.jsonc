{
  "name": "SavedSpot",
  "type": "object",
  "description": "Spot guardado por un usuario sin estar ligado a un viaje concreto. Sistema de favoritos con carpetas, similar a Instagram Saved.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID del usuario que guarda el spot"
    },
    "folder": {
      "type": "string",
      "description": "Nombre de la carpeta. Por defecto 'General'",
      "default": "General"
    },
    "title": {
      "type": "string",
      "description": "Nombre del lugar"
    },
    "type": {
      "type": "string",
      // Mismo motivo que Spot.jsonc: se guarda una copia del type al añadir
      // un spot ajeno a la wishlist (ver Profile.jsx), así que necesita
      // aceptar los mismos valores que Spot.type.
      "enum": [
        "food",
        "sight",
        "activity",
        "shopping",
        "transport",
        "custom",
        "hotel",
        "airport",
        "train",
        "bus"
      ],
      "description": "Tipo de lugar"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n del lugar"
    },
    "city_name": {
      "type": "string",
      "description": "Ciudad"
    },
    "country": {
      "type": "string",
      "description": "Pa\u00eds"
    },
    "lat": {
      "type": "number",
      "description": "Latitud"
    },
    "lng": {
      "type": "number",
      "description": "Longitud"
    },
    "link": {
      "type": "string",
      "description": "Web o enlace externo"
    },
    "notes": {
      "type": "string",
      "description": "Notas personales"
    },
    "image_url": {
      "type": "string",
      "description": "Foto del lugar"
    },
    "source_spot_id": {
      "type": "string",
      "description": "ID del Spot original si se guard\u00f3 desde el perfil de otro usuario"
    },
    "source_user_id": {
      "type": "string",
      "description": "ID del usuario original si se guard\u00f3 desde otro perfil"
    },
    "fsq_id": {
      "type": "string",
      "description": "ID de Foursquare si viene de b\u00fasqueda"
    },
    "google_place_id": {
      "type": "string",
      // Se usa para detectar "ya lo tienes" en el buscador del perfil
      // comparando por ID estable de Google en vez de por texto del título:
      // Autocomplete (New) y Place Details (New) no garantizan devolver el
      // mismo texto de nombre para el mismo sitio real (uno da el nombre
      // corto de sugerencia, el otro el nombre "oficial" completo), así que
      // comparar títulos daba falsos negativos.
      "description": "Place ID de Google si el spot viene de una b\u00fasqueda ah\u00ed"
    }
  },
  "required": [
    "user_id",
    "title",
    "type"
  ],
  "rls": {
    "read": { "data.user_id": "{{user.id}}" },
    "create": { "data.user_id": "{{user.id}}" },
    "update": { "data.user_id": "{{user.id}}" },
    "delete": { "data.user_id": "{{user.id}}" }
  }
}