{
  "name": "Expense",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "description": "ID del viaje"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Cantidad total gastada"
    },
    "currency": {
      "type": "string",
      "enum": [
        "AED",
        "AFN",
        "ALL",
        "AMD",
        "ANG",
        "AOA",
        "ARS",
        "AUD",
        "AWG",
        "AZN",
        "BAM",
        "BBD",
        "BDT",
        "BGN",
        "BHD",
        "BIF",
        "BMD",
        "BND",
        "BOB",
        "BRL",
        "BSD",
        "BTN",
        "BWP",
        "BYN",
        "BZD",
        "CAD",
        "CDF",
        "CHF",
        "CLP",
        "CNY",
        "COP",
        "CRC",
        "CUP",
        "CVE",
        "CZK",
        "DJF",
        "DKK",
        "DOP",
        "DZD",
        "EGP",
        "ERN",
        "ETB",
        "EUR",
        "FJD",
        "FKP",
        "GBP",
        "GEL",
        "GHS",
        "GIP",
        "GMD",
        "GNF",
        "GTQ",
        "GYD",
        "HKD",
        "HNL",
        "HTG",
        "HUF",
        "IDR",
        "ILS",
        "INR",
        "IQD",
        "IRR",
        "ISK",
        "JMD",
        "JOD",
        "JPY",
        "KES",
        "KGS",
        "KHR",
        "KMF",
        "KPW",
        "KRW",
        "KWD",
        "KYD",
        "KZT",
        "LAK",
        "LBP",
        "LKR",
        "LRD",
        "LSL",
        "LYD",
        "MAD",
        "MDL",
        "MGA",
        "MKD",
        "MMK",
        "MNT",
        "MOP",
        "MRU",
        "MUR",
        "MVR",
        "MWK",
        "MXN",
        "MYR",
        "MZN",
        "NAD",
        "NGN",
        "NIO",
        "NOK",
        "NPR",
        "NZD",
        "OMR",
        "PAB",
        "PEN",
        "PGK",
        "PHP",
        "PKR",
        "PLN",
        "PYG",
        "QAR",
        "RON",
        "RSD",
        "RUB",
        "RWF",
        "SAR",
        "SBD",
        "SCR",
        "SDG",
        "SEK",
        "SGD",
        "SHP",
        "SLL",
        "SOS",
        "SRD",
        "SSP",
        "STN",
        "SYP",
        "SZL",
        "THB",
        "TJS",
        "TMT",
        "TND",
        "TOP",
        "TRY",
        "TTD",
        "TWD",
        "TZS",
        "UAH",
        "UGX",
        "USD",
        "UYU",
        "UZS",
        "VES",
        "VND",
        "VUV",
        "WST",
        "XAF",
        "XCD",
        "XOF",
        "XPF",
        "YER",
        "ZAR",
        "ZMW",
        "ZWL"
      ],
      "default": "EUR"
    },
    "paid_by": {
      "type": "string",
      "description": "Email del usuario que pagó"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "transport",
        "accommodation",
        "activities",
        "shopping",
        "drinks",
        "other"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "split_type": {
      "type": "string",
      "enum": [
        "equal",
        "custom",
        "solo"
      ],
      "default": "equal",
      "description": "Tipo de división: a partes iguales o personalizado"
    },
    "split_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails de usuarios incluidos en la división (incluye paid_by)"
    },
    "amounts_by_user": {
      "type": "object",
      "description": "Cantidades específicas por usuario (solo si split_type=custom). Formato: {email: amount}"
    },
    "receipt_photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos de recibos"
    },
    "amount_base": {
      "type": "number",
      "description": "Importe convertido a la moneda base del viaje (para cálculo de balances)"
    },
    "exchange_rate": {
      "type": "number",
      "description": "Tipo de cambio usado en la conversión (currency → base_currency)"
    },
    "fx_rate_to_base": {
      "type": "number",
      "description": "Tipo de cambio usado en la conversión (currency → base_currency)"
    },
    "fx_source": {
      "type": "string",
      "description": "Fuente del tipo de cambio"
    },
    "fx_timestamp": {
      "type": "string",
      "description": "Timestamp de la obtención del tipo de cambio"
    },
    "is_settlement": {
      "type": "boolean",
      "default": false,
      "description": "true si es un registro de liquidación de deuda entre miembros (no un gasto real) — se excluye de estadísticas y desgloses"
    },
    "city_id": {
      "type": "string",
      "description": "ID de la ciudad donde ocurrió el gasto (opcional)"
    },
    "city_name": {
      "type": "string",
      "description": "Nombre de la ciudad donde ocurrió el gasto, usado en el desglose 'Por ciudad'"
    },
    "trip_members": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Copia de Trip.members en el momento de crear/sincronizar — usada por rls porque base44 no permite comprobar la pertenencia al viaje contra otra entidad. Se mantiene al día vía syncTripMembers() cada vez que cambia la membresía del viaje."
    },
    "trip_editors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Subconjunto de trip_members que NO tiene rol 'viewer' (más el creador del viaje, siempre). Se usa en rls para create/update/delete -- hallazgo #6 de la auditoría: los roles admin/editor/viewer eran decorativos porque nada distinto de trip_members se comprobaba aquí antes. Se mantiene al día en los mismos sitios que trip_members (syncTripMembers.js, y los backends de manageTripMember/acceptTripInvite/leaveTrip) más cualquier cambio de rol sin cambio de membresía. Activado en el rls el 24-ago-2026, tras ejecutar backfillTripEditors sobre los registros ya existentes (15 viajes, 0 errores)."
    }
  },
  "required": [
    "trip_id",
    "description",
    "amount",
    "paid_by",
    "split_with"
  ],
  "rls": {
    "create": { "data.trip_editors": { "$in": ["{{user.email}}"] } },
    "read": { "data.trip_members": { "$in": ["{{user.email}}"] } },
    "update": { "data.trip_editors": { "$in": ["{{user.email}}"] } },
    "delete": { "data.trip_editors": { "$in": ["{{user.email}}"] } }
  }
}