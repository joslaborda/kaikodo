{
  "name": "SpotComment",
  "type": "object",
  "description": "Comentario y valoraci\u00f3n de un usuario sobre un spot",
  "properties": {
    "spot_id": {
      "type": "string",
      "description": "ID del spot"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario"
    },
    "user_display_name": {
      "type": "string",
      "description": "Nombre visible del usuario"
    },
    "username": {
      "type": "string",
      "description": "Username del usuario"
    },
    "user_avatar": {
      "type": "string",
      "description": "URL del avatar del usuario"
    },
    "thumb": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ],
      "description": "Valoraci\u00f3n thumbs up o down"
    },
    "text": {
      "type": "string",
      "description": "Texto del comentario (opcional)"
    },
    "image_url": {
      "type": "string",
      "description": "URL de foto adjunta (opcional)"
    }
  },
  "required": [
    "spot_id",
    "user_id",
    "thumb"
  ],
  "rls": {
    // Función de comentarios/valoración de spots eliminada del todo (14 sep
    // 2026) tras la auditoría que encontró que read/create nunca comprobaban
    // la visibilidad del Spot padre (spot_id) -- alguien que conociera/
    // filtrara el id de un spot al que ya no tiene acceso podía seguir
    // leyendo/comentando sus comentarios, y el motor de rls de Base44 no
    // puede expresar esa condición cross-entity. En vez de mover esto a una
    // función backend (que habría conservado la función), se decidió
    // quitarla entera -- ver src/components/spots/SpotCard.jsx. Entidad
    // dejada huérfana sin tocar el esquema, mismo criterio que
    // ItineraryTemplate/Collection tras quitar las plantillas públicas.
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}