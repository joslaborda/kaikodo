{
  "name": "City",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "description": "ID del viaje"
    },
    "name": {
      "type": "string",
      "description": "City name"
    },
    "country": {
      "type": "string",
      "default": "Japan"
    },
    "lat": {
      "type": "number",
      "description": "Latitud real de la ciudad (Google Places) -- José 14 sep 2026, ver src/lib/cityPlaces.js. Opcional a propósito: queda vacío si la ciudad se escribió a mano sin elegir ninguna sugerencia, o en registros creados antes de este cambio. No asumir que siempre existe."
    },
    "lng": {
      "type": "number",
      "description": "Longitud real de la ciudad (Google Places) -- mismo criterio que lat, ver arriba."
    },
    "place_id": {
      "type": "string",
      "description": "José (23 sep 2026): place id de Google de la ciudad -- lo único de Places que se puede guardar sin límite (términos EEA). Sirve para refrescar lat/lng antes de 30 días (refreshPlaceCoordinates)."
    },
    "place_refreshed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Última vez que se refrescaron lat/lng desde Google (máx. 30 días)"
    },
    "photo_ref": {
      "type": "string",
      "description": "José (15 sep 2026): nombre del recurso de foto de Google Places para esta ciudad (ver src/lib/cityPlaces.js) -- sustituye el diccionario fijo de fotos por ciudad/país, que se quedaba corto con cualquier ciudad no incluida a mano (pasó con Dublín y con León). Opcional, mismo criterio que lat/lng: puede faltar si la ciudad se escribió a mano o es de antes de este cambio."
    },
    "image_url": {
      "type": "string",
      "description": "Cover image URL"
    },
    "order": {
      "type": "number",
      "description": "Order in itinerary"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date of stay"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date of stay"
    },
    "accommodation": {
      "type": "string",
      "description": "Nombre del alojamiento (hotel, Airbnb, etc.)"
    },
    "trip_members": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Copia de Trip.members en el momento de crear/sincronizar — usada por rls porque base44 no permite comprobar la pertenencia al viaje contra otra entidad. Se mantiene al día vía syncTripMembers() cada vez que cambia la membresía del viaje."
    },
    "trip_editors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Subconjunto de trip_members que NO tiene rol 'viewer' (más el creador del viaje, siempre) -- ver el mismo campo en Expense.jsonc para el porqué completo. Activado en el rls el 24-ago-2026, tras ejecutar backfillTripEditors sobre los registros ya existentes (15 viajes, 0 errores)."
    }
  },
  "required": [
    "trip_id",
    "name"
  ],
  "rls": {
    "create": { "data.trip_editors": { "$in": ["{{user.email}}"] } },
    "read": { "data.trip_members": { "$in": ["{{user.email}}"] } },
    "update": { "data.trip_editors": { "$in": ["{{user.email}}"] } },
    "delete": { "data.trip_editors": { "$in": ["{{user.email}}"] } }
  }
}