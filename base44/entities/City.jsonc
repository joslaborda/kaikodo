{
  "name": "City",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "description": "ID del viaje"
    },
    "name": {
      "type": "string",
      "description": "City name"
    },
    "country": {
      "type": "string",
      "default": "Japan"
    },
    "image_url": {
      "type": "string",
      "description": "Cover image URL"
    },
    "order": {
      "type": "number",
      "description": "Order in itinerary"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date of stay"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date of stay"
    },
    "accommodation": {
      "type": "string",
      "description": "Nombre del alojamiento (hotel, Airbnb, etc.)"
    },
    "trip_members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Copia de Trip.members, usada por rls. Se mantiene al d\u00eda v\u00eda syncTripMembers()."
    },
    "trip_editors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Subconjunto de trip_members que NO es viewer (mas el creador). Usado en rls create/update/delete cuando se active -- ver hallazgo #6. TODAVIA no lo usa el rls a proposito, hace falta backfillTripEditors primero."
    }
  },
  "required": [
    "trip_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.trip_members": {
        "$in": [
          "{{user.email}}"
        ]
      }
    },
    "read": {
      "data.trip_members": {
        "$in": [
          "{{user.email}}"
        ]
      }
    },
    "update": {
      "data.trip_members": {
        "$in": [
          "{{user.email}}"
        ]
      }
    },
    "delete": {
      "data.trip_members": {
        "$in": [
          "{{user.email}}"
        ]
      }
    }
  }
}