{
  "name": "PackingItem",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string",
      "description": "ID del viaje"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario dueño"
    },
    "name": {
      "type": "string",
      "description": "Nombre del artículo"
    },
    "category": {
      "type": "string",
      "enum": [
        "personal",
        "neceser",
        "tecnologia",
        "ropa",
        "medicinas",
        "otros",
        "souvenir"
      ],
      "description": "Categoría del artículo"
    },
    "packed": {
      "type": "boolean",
      "default": false
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "essential": {
      "type": "boolean",
      "default": false,
      "description": "Marca el artículo como esencial (se resalta y se cuenta aparte)"
    },
    "trip_members": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Copia de Trip.members en el momento de crear/sincronizar — usada por rls porque base44 no permite comprobar la pertenencia al viaje contra otra entidad. Se mantiene al día vía syncTripMembers() cada vez que cambia la membresía del viaje."
    }
  },
  "required": [
    "trip_id",
    "user_id",
    "name",
    "category"
  ],
  "rls": {
    // Fix: la maleta es individual — cada usuario solo debe poder leer,
    // crear, actualizar o borrar SUS PROPIOS items (data.user_id ==
    // {{user.id}}), no los de todos los miembros del viaje. Antes el rls
    // solo comprobaba pertenencia al viaje (data.trip_members), así que
    // cualquier miembro podía leer/marcar/borrar los items de los demás.
    // create exige además pertenencia al viaje para que solo un miembro
    // real del trip pueda crear items en él (paridad con el resto de
    // entidades de viaje) y user_id == {{user.id}} para evitar que alguien
    // cree un item "a nombre" de otro usuario.
    "create": {
      "$and": [
        { "data.trip_members": { "$in": ["{{user.email}}"] } },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "read": { "data.user_id": "{{user.id}}" },
    "update": { "data.user_id": "{{user.id}}" },
    "delete": { "data.user_id": "{{user.id}}" }
  }
}
