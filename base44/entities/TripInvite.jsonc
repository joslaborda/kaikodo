{
  "name": "TripInvite",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "invite_token": {
      "type": "string"
    },
    "invited_by": {
      "type": "string"
    },
    "responded_date": {
      "type": "string"
    },
    "preview_count": {
      "type": "number",
      // Cuántas veces se ha pedido la vista previa SIN sesión (ver
      // getInvitePreview) en la ventana actual -- getInvitePreview es una
      // función de backend deliberadamente sin login (tiene que funcionar
      // para alguien que todavía no tiene cuenta), así que el propio token
      // es la única protección. Sin este contador, cualquiera con un token
      // real podría bombardear el endpoint sin límite.
      "description": "Intentos de vista previa sin sesión en la ventana actual"
    },
    "preview_window_start": {
      "type": "string",
      "description": "Inicio (ISO) de la ventana de conteo de preview_count"
    }
  },
  "required": [
    "trip_id",
    "email",
    "role",
    "status",
    "invite_token",
    "invited_by"
  ],
  "rls": {
    "create": false,
    // Nota pendiente de verificación en vivo (no corregible solo con código):
    // data.email/data.invited_by siempre se guardan en minúsculas
    // (createTripInvite normaliza con .trim().toLowerCase()), pero no está
    // confirmado si el motor de rls de base44 normaliza también el valor de
    // {{user.email}} antes de comparar. Si un proveedor de login (p. ej.
    // Google) devolviera el email de sesión con mayúsculas, esta comparación
    // podría no coincidir nunca y la persona invitada no vería su propia
    // invitación al leerla desde el cliente. Requiere una prueba en vivo con
    // una cuenta cuyo email de sesión tenga mayúsculas para confirmar o
    // descartar esto.
    "read": {
      "$or": [
        { "data.email": "{{user.email}}" },
        { "data.invited_by": "{{user.email}}" }
      ]
    },
    // Antes esto permitía a quien fuera el "email" o "invited_by" de UNA
    // invitación propia reescribir CUALQUIER campo de esa fila, incluidos
    // trip_id y role — y como acceptTripInvite confía en esos dos campos,
    // eso permitía autoasignarse admin de un viaje ajeno con solo conocer su
    // id. Este motor de reglas no puede restringir qué campos se cambian
    // dentro de un update, así que se cierra del todo: aceptar/rechazar/
    // cancelar una invitación corre en el backend (acceptTripInvite,
    // respondToTripInvite) con asServiceRole, tocando solo status y
    // responded_date.
    "update": false,
    "delete": false
  }
}