{
  "name": "CaptchaChallenge",
  "type": "object",
  "properties": {
    "challenge": {
      "type": "string"
    },
    "difficulty": {
      "type": "number"
    },
    "used": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "ip_hash": {
      "type": "string",
      "description": "Hash (no la IP en claro) de quien pidió el reto -- límite de retos pendientes por IP"
    }
  },
  "required": [
    "challenge",
    "difficulty",
    "used",
    "expires_at"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}